# Which LLM to use: gemini (default) | openai | anthropic | ollama
LLM_PROVIDER=gemini

# --- Gemini (free tier, default) ---
GEMINI_API_KEY=your_gemini_key_here
# GEMINI_MODEL=gemini-3.8-flash   # optional override

# --- OpenAI ---
# OPENAI_API_KEY=your_openai_key_here
# OPENAI_MODEL=gpt-4o-mini        # optional override

# --- Anthropic ---
# ANTHROPIC_API_KEY=your_anthropic_key_here
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001  # optional override

# Max changed lines before the bot skips the review (default: 400)
# MAX_DIFF_LINES=400

# --- Ollama (self-hosted, no API key needed) ---
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.1
